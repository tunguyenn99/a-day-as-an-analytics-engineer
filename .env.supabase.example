# Supabase direct/session connection; avoid transaction pooler for dbt.
PGHOST=db.hdbmxpzqzpagrbfqrcdn.supabase.co
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=
PGSSLMODE=require
DBT_SCHEMA=analytics
DBT_TARGET=prod
# Supabase: require SSL, use S3 access keys (not anon/service-role JWT).
S3_ENDPOINT_URL=https://hdbmxpzqzpagrbfqrcdn.storage.supabase.co/storage/v1/s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
S3_BUCKET=analytics
OPENMETADATA_HOST=http://localhost:8585/api
OPENMETADATA_JWT=
OPENMETADATA_SERVICE=supabase
GRAFANA_ADMIN_PASSWORD=local-only-change-me
# Optional Slack-compatible incoming webhook for Airflow task failures.
ALERT_WEBHOOK_URL=
AIRFLOW_PGHOST=db.hdbmxpzqzpagrbfqrcdn.supabase.co

# Read-only Xomdata SQL Server source; credentials belong in .env only.
MSSQL_HOST=45.124.94.158
MSSQL_PORT=1433
MSSQL_DATABASE=xomdata_dataset
MSSQL_SCHEMA=web_analytics
MSSQL_USER=
MSSQL_PASSWORD=
